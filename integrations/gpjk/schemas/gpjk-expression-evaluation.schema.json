{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Abdus2023/reusable-process-system/integrations/gpjk/schema/gpjk-expression-evaluation.schema.json",
  "title":"GPJK Expression Evaluation Contract",
  "type":"object","additionalProperties":false,
  "required":["expression","result"],
  "properties":{
    "expression":{"type":"string","minLength":1},
    "result":{"enum":["TRUE","FALSE","UNKNOWN"]},
    "trace":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "error":{"type":"string"}
  }
}